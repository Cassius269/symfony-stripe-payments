{% extends 'base.html.twig' %}

{% block title %}La page d'accueil
{% endblock %}

{% block body %}
	<h1>Nous sommes dans la page d'accueil</h1>
	<section>
		<p>Cart ID:
			{{cartId}}</p>
	</section>
	<section>
		<h2>Les produits</h2>
		<ul>
			{% for product in products %}
				<li>{{product.name}}</li>
			{% endfor %}
		</ul>
		

	</section>

{% endblock %}
